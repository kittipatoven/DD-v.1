# DD Computer - Production Environment Variables
# Copy this file to .env.production on your server

# ============================================
# DOMAIN CONFIGURATION
# ============================================
# Set your domain name here (e.g., ddcomputersamrong.com)
# Leave empty to use IP address
DOMAIN_NAME=ddcomputersamrong.com

# Use HTTPS (true) or HTTP (false)
# Set to true when using Let's Encrypt SSL certificate
USE_HTTPS=true

# Server IP (fallback when DOMAIN_NAME is empty)
SERVER_IP=185.84.160.236

# ============================================
# DATABASE CONFIGURATION
# ============================================
MYSQL_ROOT_PASSWORD=ddcomputer168

# ============================================
# BACKEND CONFIGURATION
# ============================================
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=${MYSQL_ROOT_PASSWORD}
DB_DATABASE=dd_computer
PORT=3001
NODE_ENV=production

# ============================================
# API & CORS CONFIGURATION
# ============================================
# URLs are automatically set based on DOMAIN_NAME and USE_HTTPS
# If DOMAIN_NAME is set and USE_HTTPS=true: https://ddcomputersamrong.com
# If DOMAIN_NAME is set and USE_HTTPS=false: http://ddcomputersamrong.com
# If DOMAIN_NAME is empty: http://185.84.160.236
API_URL=https://ddcomputersamrong.com
CORS_ORIGIN=https://ddcomputersamrong.com
FRONTEND_URL=https://ddcomputersamrong.com

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_VERY_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://ddcomputersamrong.com/api/v1/auth/google/callback

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=https://ddcomputersamrong.com/api/v1
NEXT_PUBLIC_WS_URL=wss://ddcomputersamrong.com
NEXT_PUBLIC_SITE_URL=https://ddcomputersamrong.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
