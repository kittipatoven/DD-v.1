# DD Computer — Production (.env สำหรับ docker-compose.prod.yml)
# cp .env.production.example .env แล้วแก้ค่าทั้งหมด

MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Backend
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=${MYSQL_ROOT_PASSWORD}
DB_DATABASE=dd_computer
PORT=3001
NODE_ENV=production

# Public URLs — ใช้โดเมนจริง (ไม่ใช้ localhost)
API_URL=https://ddcomputersamrong.com
CORS_ORIGIN=https://ddcomputersamrong.com,https://www.ddcomputersamrong.com
FRONTEND_URL=https://ddcomputersamrong.com

JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://ddcomputersamrong.com/api/v1/auth/google/callback

# Frontend (build-time + runtime) — ชี้ผ่าน Nginx same-origin
NEXT_PUBLIC_API_URL=https://ddcomputersamrong.com/api/v1
NEXT_PUBLIC_WS_URL=https://ddcomputersamrong.com
NEXT_PUBLIC_SITE_URL=https://ddcomputersamrong.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
