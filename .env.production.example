# DD Computer - Production Environment Variables
# Copy this file to .env.production and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
MYSQL_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ============================================
# BACKEND CONFIGURATION
# ============================================
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=${MYSQL_ROOT_PASSWORD}
DB_DATABASE=dd_computer
PORT=3001
NODE_ENV=production

# ============================================
# API & CORS CONFIGURATION
# ============================================
# Replace with your actual domain
API_URL=https://ddcomputer.com
CORS_ORIGIN=https://ddcomputer.com,https://www.ddcomputer.com
FRONTEND_URL=https://ddcomputer.com

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate a strong random secret
JWT_SECRET=CHANGE_THIS_TO_A_VERY_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d

# ============================================
# GOOGLE OAUTH CONFIGURATION
# ============================================
# Get these from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://ddcomputer.com/api/v1/auth/google/callback

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=https://ddcomputer.com/api/v1
NEXT_PUBLIC_WS_URL=https://ddcomputer.com
NEXT_PUBLIC_SITE_URL=https://ddcomputer.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
